{
  "name": "dsh-deepseek-pricing",
  "version": "0.2.1",
  "description": "DeepSeek 计费时段与模型价格：输入框状态徽章 + 设置页价格表 + 每轮花费估算，功能开关收在插件页面。",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hai55555/dsh-deepseek-pricing.git"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "pricing",
    "peak",
    "dsh-plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
